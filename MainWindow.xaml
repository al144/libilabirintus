<Window x:Class="libilabirintus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:libilabirintus"
        mc:Ignorable="d"
        KeyDown="Game_OnKeyDown"
        Title="Libilabirintus" Height="800" Width="1300" ResizeMode="NoResize">
    
    <Grid x:Name="MainContainer">
        
        <Grid x:Name="CreatePlayerGrid" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
                <TextBlock Text="Jatekos Letrehozasa"
                           FontSize="30"
                           Margin="0,0,0,20"
                           TextAlignment="Center"/>

                <TextBox x:Name="CreateUserNameBox"
                         Height="35"
                         FontSize="22"
                         Margin="0,0,0,10"/>

                <PasswordBox x:Name="CreatePasswordBox"
                             Height="35"
                             FontSize="22"
                             Margin="0,0,0,20"/>

                <Button Content="Belépés"
                        Height="35" Click="CreatePlayerButton"/>
            </StackPanel>       

            
        </Grid>
        
        <Grid x:Name="LoginGrid" Background="AliceBlue" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
           
                <TextBlock Text="Bejelentkezés"
                           FontSize="30"
                           Margin="0,0,0,20"
                           TextAlignment="Center"/>

                <TextBox x:Name="LoginUsernameBox"
                         Height="35"
                         FontSize="22"
                         Margin="0,0,0,10"/>

                <PasswordBox x:Name="LoginPasswordBox"
                             Height="35"
                             FontSize="22"
                             Margin="0,0,0,20"/>

                <Button Content="Belépés"
                        Height="35" Click="LoginButton"/>
                <Button Content="Jatekos letrehozasa" Height="35" Click="GoToCreatePlayerButton"></Button>
            </StackPanel>       
        </Grid>
        
        <Grid x:Name="SelectorGrid" Visibility="Collapsed">
           <Grid.ColumnDefinitions>
               <ColumnDefinition Width="300"/>
               <ColumnDefinition Width="1000"/>
           </Grid.ColumnDefinitions> 
            
            <StackPanel>
                <ListBox Grid.Column="0" x:Name="SelectionListBox" Width="300" Height="500" KeyDown="SelectEnter" HorizontalAlignment="Left" SelectionChanged="SelectionChanged"/> 
                <Button Content="Mentesfajl betoltese" Click="LoadSaveButton_OnClick"></Button>
                <Label Content="Adja meg a map nevet"></Label>
                <TextBox x:Name="MazeNameBlock"></TextBox>
                <Button Content="Map Feltoltese" Click="UploadMazeButton"></Button>
            </StackPanel>
            <Grid Grid.Column="1" x:Name="preGrid" VerticalAlignment="Center" ></Grid>
            <Grid Grid.Column="1" x:Name="QuestionGrid" Width="1000" Height="800" Background="AliceBlue" Visibility="Collapsed">
                <StackPanel >
                    <Label Content="Rejtve van az elonezet" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="70"
                           Width="800"
                           Height="200"/>
                
                    <Button Content="Jatekmod Valaszto"
                            Height="500"
                            Width="600"
                            Click="GoToGamemode"/>
                
                </StackPanel> 
            </Grid>
                
        </Grid>
        
        <Grid x:Name="InGameGrid" Visibility="Collapsed">
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="2.5*"/>
            </Grid.RowDefinitions>

            <!-- upper bar -->
            <Label Grid.Row="0" Background="Black"></Label>
            <StackPanel >
                <Label x:Name="PointLabel" Content="Pontok" Foreground="Aqua"></Label>
                <Label x:Name="StepsLabel" Content="Lepesek" Foreground="Aqua"></Label>
                <Label x:Name="CoordinateLabel" Content="Koordinatak" Foreground="Aqua"></Label>
            </StackPanel>

            <!-- maze -->
            <Label Grid.Row="1" Background="Gray"></Label>
            <Grid x:Name="citygrid" Grid.Row="1"/>

        </Grid>
        
        <Grid x:Name="PauseGrid" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Label Content="Játék megállítva"
                       HorizontalAlignment="Center"
                       FontSize="30"
                       Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Folytatás"
                            Width="200"
                            Height="100"
                            Margin="10"
                            Click="BackToInGame"/>

                    <Button Content="Mentés és kilépés"
                            Width="200"
                            Height="100"
                            Margin="10"
                            Click="SaveAndToSelector"/>

                </StackPanel>

            </StackPanel>
        </Grid>
        
        <Grid x:Name="GameModeGrid" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Label Content="Valasszon Jatekmodot"
                       HorizontalAlignment="Center"
                       FontSize="30"
                       Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Normal Kijutas"
                            Width="200"
                            Height="100"
                            Margin="10"
                            Click="NormalStart"/>

                    <Button Content="Rejtett kereses"
                            Width="200"
                            Height="100"
                            Margin="10"
                            Click="HiddenStart"/>

                </StackPanel>

            </StackPanel>
        </Grid>
           
    </Grid> 
</Window>
