<Window x:Class="libilabirintus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:libilabirintus"
        mc:Ignorable="d"
        Title="Libilabirintus" Height="800" Width="1300" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2.5*"/>
        </Grid.RowDefinitions>

        <!-- upper bar -->
        <Label Grid.Row="0" Background="Black"></Label>
        <Label x:Name="debug" Grid.Row="0" Content="dasda" Background="AliceBlue"/>

        <!-- maze -->
        <Label Grid.Row="1" Background="Gray"/>
        <Grid x:Name="citygrid" Grid.Row="1"/>

    </Grid>
</Window>
